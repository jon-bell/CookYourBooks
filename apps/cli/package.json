{
  "name": "@cookyourbooks/cli",
  "version": "0.0.0",
  "private": true,
  "description": "Command-line client for CookYourBooks. Library commands use a CLI token minted in the app; `cyb demo` signs in as a user to load demo content.",
  "type": "module",
  "bin": {
    "cyb": "./dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:commander --external:@supabase/supabase-js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@cookyourbooks/db": "workspace:*",
    "@cookyourbooks/domain": "workspace:*",
    "@supabase/supabase-js": "^2.46.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "esbuild": "^0.25.12"
  }
}
